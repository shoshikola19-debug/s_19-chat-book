# S_19 CHAT BOOK — environment variables
# Copy this file to .env and fill in the values. Never commit a real .env.
# All SMS variables are OPTIONAL. If they are empty, the app runs in TEST
# mode: the 6-digit login code is shown on screen (exactly like the current
# test version). When the SMS variables are set, the code is sent by real
# SMS instead and is NOT shown on screen.

# Which gateway to use: "amarsms" or "cloudwave" (HTTP API style).
# Leave empty for test mode.
SMS_PROVIDER=

# Base URL of the gateway's send-SMS endpoint, e.g.
#   https://api.amarsms.com/api/v1/sms
#   https://api.cloudwavebd.com/sms/send
SMS_API_URL=

# API key / token from the gateway dashboard. NEVER put a real key in git.
SMS_API_KEY=

# Sender ID / mask shown on the phone, e.g. S_19 (must be approved by the
# gateway / BTRC for masking; non-masking sends from a regular number).
SMS_SENDER_ID=

# --- Gmail login (email code) ----------------------------------------------
# Optional, same pattern as SMS. If these are set, a Gmail code is sent by
# real email; if not, the code is shown on screen (test mode). Email codes
# are FREE, unlike SMS — Resend's free tier allows 100 emails/day.
# Provider "resend" uses the Resend HTTP API; "generic" uses a plain
# JSON POST API (api_key + from + to + subject + message).
EMAIL_PROVIDER=

# Send-email endpoint URL, e.g. https://api.resend.com/emails
EMAIL_API_URL=

# API key from the email provider dashboard. NEVER put a real key in git.
EMAIL_API_KEY=

# Sender address shown in the inbox,
# e.g. "S_19 CHAT BOOK <login@s19chatbook.app>"
EMAIL_FROM=

# --- Web Push notifications (call/message alerts when app is closed) -----
# Optional. If these are empty, push is disabled and the app works exactly
# as before (calls/messages only arrive while the app is open).
# VAPID_PUBLIC_KEY is public — the frontend fetches it from the server.
# VAPID_PRIVATE_KEY is SECRET — it is in .vapid-private-key.txt (gitignored).
# Set BOTH in the Render Dashboard (Environment tab), never in git or chat.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# --- অ্যাডমিন প্যানেল (কে অ্যাডমিন দেখবে) --------------------------------------
# Optional. অ্যাডমিনের ফোন নম্বর (অ্যাপের ভেতরের ফরম্যাটে, যেমন
# 8801XXXXXXXXX — দেশের কোডসহ, + ছাড়া) বা Gmail, কমা দিয়ে আলাদা করে:
#   ADMIN_USERS=8801XXXXXXXXX,shoshikola19@gmail.com
# এটা না বসালে কেউ অ্যাডমিন না — অ্যাপে অ্যাডমিন ট্যাব কাউকে দেখাবে না।
# অ্যাডমিন হলে অ্যাপে নিচে অ্যাডমিন ট্যাব আসে: পরিসংখ্যান, ব্যবহারকারী
# ব্লক/আনব্লক, চ্যানেল মোছা, সবাইকে ঘোষণা, স্বাগতম পাতার ব্যানার।
ADMIN_USERS=

# Port the server listens on (Render sets PORT automatically).
PORT=3000

# Permanent database (Neon Postgres, free tier). Set this to the Neon
# connection string, e.g.
#   postgresql://neondb_owner:********@ep-xxx-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
# When DATABASE_URL is set the app uses Postgres and data survives
# restarts; when it is empty the app uses the local SQLite file below.
# NEVER put a real connection string in git — set it in the Render
# Dashboard (Environment tab) instead. The code strips
# channel_binding=require automatically (Neon's pooler rejects it).
DATABASE_URL=

# Where the SQLite database file lives (only used when DATABASE_URL is
# empty). On Render free tier the disk is ephemeral: data is lost on
# redeploy/restart. For a permanent database, set DATABASE_URL above.
DB_PATH=./s19.db
