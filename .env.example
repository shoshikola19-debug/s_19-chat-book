# S_19 CHAT BOOK — environment variables
# Copy this file to .env and fill in the values. Never commit a real .env.
# All SMS variables are OPTIONAL. If they are empty, the app runs in TEST
# mode: the 6-digit login code is shown on screen (exactly like the current
# test version). When the SMS variables are set, the code is sent by real
# SMS instead and is NOT shown on screen.

# Which gateway to use: "amarsms" or "cloudwave" (HTTP API style).
# Leave empty for test mode.
SMS_PROVIDER=

# Base URL of the gateway's send-SMS endpoint, e.g.
#   https://api.amarsms.com/api/v1/sms
#   https://api.cloudwavebd.com/sms/send
SMS_API_URL=

# API key / token from the gateway dashboard. NEVER put a real key in git.
SMS_API_KEY=

# Sender ID / mask shown on the phone, e.g. S_19 (must be approved by the
# gateway / BTRC for masking; non-masking sends from a regular number).
SMS_SENDER_ID=

# --- Gmail login (email code) ----------------------------------------------
# Optional, same pattern as SMS. If these are set, a Gmail code is sent by
# real email; if not, the code is shown on screen (test mode). Email codes
# are FREE, unlike SMS.
#
# Provider "gmail_oauth" (RECOMMENDED — the production path on Render):
# Sends through Bijoy's OWN Gmail (s19chatbook@gmail.com) using the
# Gmail API over HTTPS (port 443), so it works on Render's free tier.
# No third-party gatekeeper, no phone verification, no trial expiry,
# no domain needed. The app holds a refresh token (made once) and
# swaps it for a fresh access token on every send. Setup (once):
#   1. console.cloud.google.com → create a project, e.g. "S19 CHAT BOOK".
#   2. APIs & Services → Library → search "Gmail API" → Enable.
#   3. APIs & Services → OAuth consent screen → External → app name
#      "S_19 CHAT BOOK", user support email s19chatbook@gmail.com →
#      IMPORTANT: set the consent screen publishing status to
#      Production (In production) — NOT Testing — or the refresh token
#      expires after 7 days. The "unverified app" warning screen is
#      expected for a personal project: click Advanced → Go to
#      S_19 CHAT BOOK (unsafe) to continue.
#   4. APIs & Services → Credentials → Create Credentials → OAuth
#      client ID → Web application → redirect URI http://localhost →
#      copy the client ID and the client secret.
#   5. Authorize with s19chatbook@gmail.com for the scope
#      https://www.googleapis.com/auth/gmail.send with
#      access_type=offline → exchange the one-time code for a refresh
#      token (the refresh token is shown once — copy it at once).
#   6. EMAIL_PROVIDER=gmail_oauth,
#      GMAIL_OAUTH_CLIENT_ID=that client ID,
#      GMAIL_OAUTH_CLIENT_SECRET=that client secret,
#      GMAIL_OAUTH_REFRESH_TOKEN=that refresh token,
#      EMAIL_FROM=s19chatbook@gmail.com.
#      NEVER put the real id/secret/token in git — set them in the
#      Render Dashboard (Environment tab) instead.
# Why Gmail API and not the others: Mailjet's Compliance team DECLINED
# activation and CLOSED the account (decision final); Brevo's API key
# needs phone verification and the SMS never arrives; Gmail SMTP is
# blocked on Render free tier (ports 25/465/587). SendGrid was also
# ruled out (phone verification at signup + free plan is only a
# 60-day trial, then ~$20/month).
# Provider "mailjet" is DEAD for us: Mailjet's Compliance team declined
# the activation request and closed the account (decision final, no
# appeal). Free (6,000 emails/month, 200/day, no card) and needs NO
# domain and NO phone verification: validate ONE sender email address
# in Mailjet and it can send to ANY Gmail:
#   1. app.mailjet.com → Sign Up (free) → log in.
#   2. Account Settings → Sender domains and addresses → add the Gmail
#      that sends the codes (e.g. s19chatbook@gmail.com) as a sender →
#      Mailjet emails a confirmation link to that inbox → open it and
#      click it. (Mailjet's menu names can change; look for "Sender
#      domains and addresses" under Account Settings.)
#   3. Account Settings → REST API → API Key Management → the API Key
#      and the Secret Key. The Secret Key is shown ONCE — copy it at
#      once; if you close the page without copying it, make a new one.
#   4. EMAIL_PROVIDER=mailjet, EMAIL_API_KEY=that API Key,
#      EMAIL_API_SECRET=that Secret Key,
#      EMAIL_FROM=the validated sender Gmail address.
#      NEVER put the real key or secret in git — set them in the Render
#      Dashboard (Environment tab) instead.
# Provider "brevo" is BLOCKED for us: creating a Brevo API key needs
# phone verification and the SMS code never arrives on the phone, so no
# Brevo key can be made. (Brevo is also free, 300 emails/day, no card,
# no domain — verify ONE sender in Brevo: Settings → Senders & IP →
# Add a sender → confirmation email; API key at Settings → SMTP & API
# → API Keys. Endpoint https://api.brevo.com/v3/smtp/email — kept in
# code as a fallback if Brevo ever works.)
# Provider "smtp" (LOCAL TESTING ONLY) uses Gmail SMTP with an App
# Password — no domain, no card, no per-email cost, but Render's free
# tier blocks SMTP ports, so it only works when the server runs on your
# own computer:
#   1. Google Account → Security → 2-Step Verification → ON.
#   2. Same page → App passwords → create one (name it "S_19 CHAT BOOK").
#      Google shows a 16-character password ONCE — copy it.
#   3. EMAIL_PROVIDER=smtp, EMAIL_SMTP_USER=that Gmail address,
#      EMAIL_SMTP_PASS=that 16-character password (no spaces).
# Provider "resend" uses the Resend HTTP API (100 emails/day free);
# "generic" uses a plain JSON POST API (api_key + from + to + subject
# + message). Resend's free tier without a verified domain can only send
# to the Resend account's own email, so use "gmail_oauth" for real Gmail logins.
EMAIL_PROVIDER=

# Send-email endpoint URL, e.g. https://api.resend.com/emails
# (resend / generic only — smtp does not use it; brevo defaults to
# https://api.brevo.com/v3/smtp/email and mailjet defaults to
# https://api.mailjet.com/v3.1/send when this is empty; gmail_oauth
# uses GMAIL_API_URL instead, defaulting to the Gmail send endpoint)
EMAIL_API_URL=

# API key from the email provider dashboard. NEVER put a real key in git.
# (resend / generic / brevo / mailjet — smtp does not use it)
EMAIL_API_KEY=

# Mailjet Secret Key (provider "mailjet" only). Shown ONCE when created —
# copy it at once. NEVER put a real secret in git.
EMAIL_API_SECRET=

# Gmail API OAuth2 settings (provider "gmail_oauth" only).
# The client ID and client secret come from the Google Cloud OAuth
# client (see above). The refresh token comes from authorizing once
# with the sending Gmail account. NEVER put real values in git — set
# them in the Render Dashboard (Environment tab) instead.
GMAIL_OAUTH_CLIENT_ID=
GMAIL_OAUTH_CLIENT_SECRET=
GMAIL_OAUTH_REFRESH_TOKEN=
# Optional overrides (the defaults work — leave empty unless testing):
# token endpoint, default https://oauth2.googleapis.com/token
GMAIL_OAUTH_TOKEN_URL=
# Gmail send endpoint, default
# https://gmail.googleapis.com/gmail/v1/users/me/messages/send
GMAIL_API_URL=

# Sender address shown in the inbox.
# (gmail_oauth: MUST be the Gmail account the refresh token belongs to,
# e.g. s19chatbook@gmail.com. mailjet / brevo: MUST be the sender
# address validated/verified in Mailjet/Brevo, e.g.
# s19chatbook@gmail.com — a plain address is enough.
# smtp: leave empty to send as "S_19 CHAT BOOK <EMAIL_SMTP_USER>".)
EMAIL_FROM=

# Gmail SMTP settings (provider "smtp" only).
# Defaults work for Gmail: host smtp.gmail.com, port 587, STARTTLS.
# For port 465 instead, set EMAIL_SMTP_PORT=465 and EMAIL_SMTP_SECURE=true.
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=
EMAIL_SMTP_SECURE=
# The Gmail address that sends the login codes.
EMAIL_SMTP_USER=
# The 16-character Gmail App Password. NEVER put a real password in git.
EMAIL_SMTP_PASS=

# --- Web Push notifications (call/message alerts when app is closed) -----
# Optional. If these are empty, push is disabled and the app works exactly
# as before (calls/messages only arrive while the app is open).
# VAPID_PUBLIC_KEY is public — the frontend fetches it from the server.
# VAPID_PRIVATE_KEY is SECRET — it is in .vapid-private-key.txt (gitignored).
# Set BOTH in the Render Dashboard (Environment tab), never in git or chat.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# --- অ্যাডমিন প্যানেল (কে অ্যাডমিন দেখবে) --------------------------------------
# Optional. অ্যাডমিনের ফোন নম্বর (অ্যাপের ভেতরের ফরম্যাটে, যেমন
# 8801XXXXXXXXX — দেশের কোডসহ, + ছাড়া) বা Gmail, কমা দিয়ে আলাদা করে:
#   ADMIN_USERS=8801XXXXXXXXX,shoshikola19@gmail.com
# এটা না বসালে কেউ অ্যাডমিন না — অ্যাপে অ্যাডমিন ট্যাব কাউকে দেখাবে না।
# অ্যাডমিন হলে অ্যাপে নিচে অ্যাডমিন ট্যাব আসে: পরিসংখ্যান, ব্যবহারকারী
# ব্লক/আনব্লক, চ্যানেল মোছা, সবাইকে ঘোষণা, স্বাগতম পাতার ব্যানার।
ADMIN_USERS=

# Port the server listens on (Render sets PORT automatically).
PORT=3000

# Permanent database (Neon Postgres, free tier). Set this to the Neon
# connection string, e.g.
#   postgresql://neondb_owner:********@ep-xxx-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
# When DATABASE_URL is set the app uses Postgres and data survives
# restarts; when it is empty the app uses the local SQLite file below.
# NEVER put a real connection string in git — set it in the Render
# Dashboard (Environment tab) instead. The code strips
# channel_binding=require automatically (Neon's pooler rejects it).
DATABASE_URL=

# Where the SQLite database file lives (only used when DATABASE_URL is
# empty). On Render free tier the disk is ephemeral: data is lost on
# redeploy/restart. For a permanent database, set DATABASE_URL above.
DB_PATH=./s19.db
